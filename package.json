{
  "name": "capsule-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "胶囊知识库客户端与本地运行入口",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "capsule": "src/cli.mjs"
