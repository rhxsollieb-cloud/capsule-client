{
  "name": "capsule-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "胶囊知识库客户端与本地运行入口",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "capsule": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "build:web": "node scripts/build-web.mjs",
    "package:client": "node scripts/package-client.mjs",
    "preui": "npm run build:web",
    "ui": "node src/ui/main.mjs",
    "pretest": "npm run build:web",
    "test": "node scripts/test.mjs",
    "pretest:e2e": "npm run build:web",
    "test:e2e": "playwright test",
    "pretest:e2e:editing": "npm run build:web",
    "test:e2e:editing": "playwright test test/e2e/editing.spec.mjs test/e2e/text-editing.spec.mjs test/e2e/database-editing.spec.mjs test/e2e/properties-editing.spec.mjs test/e2e/office-editing.spec.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report .local/playwright/report",
    "check": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "16.4.0"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "docx": "9.15.3",
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "mammoth": "1.13.0",
    "markdown-it": "15.0.3",
    "parse5": "8.0.0",
    "saxes": "6.0.0",
    "tabulator-tables": "6.7.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  }
}
